#!/usr/bin/env bash
set -euo pipefail

# Backstop against committing secrets/state even via `git add -f` or an edited
# .gitignore. The .claude/ overlay ships only curated config; credentials, history, and
# session transcripts must never reach the remote. The .reticulum/ overlay ships only the
# config file; rnsd keeps this node's private keys beside it in storage/
# (transport_identity, ratchets) and this repository is public. See CLAUDE.md.
deny='(^|/)\.credentials\.json$|(^|/)history\.jsonl$|(^|/)\.claude/settings\.local\.json$|(^|/)\.claude/mcp-needs-auth-cache\.json$|(^|/)\.claude/(projects|sessions|shell-snapshots|cache|paste-cache|file-history|backups|debug|session-env|tasks|plans|plugins)/|(^|/)\.reticulum/storage/'

blocked=$(git diff --cached --name-only --diff-filter=ACM | grep -E "$deny" || true)
if [ -n "$blocked" ]; then
	echo "pre-commit: refusing to commit secrets/state:" >&2
	echo "$blocked" | sed 's/^/  /' >&2
	echo "These are local/deploy-time only. Override with --no-verify if you are certain." >&2
	exit 1
fi

# The Reticulum config is tracked on purpose (it is the one path .gitignore re-includes),
# so only its content can be guarded here: an IFAC passphrase or network name in it would
# publish a shared secret to a public repository.
if git diff --cached --name-only --diff-filter=ACM | grep -qx '\.reticulum/config'; then
	if git show :.reticulum/config | grep -qiE '^[[:space:]]*(passphrase|network_name)[[:space:]]*='; then
		echo "pre-commit: refusing to commit a Reticulum IFAC secret in .reticulum/config" >&2
		echo "Move it out of the tracked config. Override with --no-verify if you are certain." >&2
		exit 1
	fi
fi
